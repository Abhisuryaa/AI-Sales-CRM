# ---------- Web (Next.js) ----------
NEXTAUTH_SECRET=change-me-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Direct Postgres (Prisma). Supabase: paste the pooler connection string instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_sales_crm

# Agents API called from the web app
AGENTS_API_URL=http://127.0.0.1:8000

# ---------- Agents (FastAPI) ----------
REDIS_URL=redis://127.0.0.1:6380/0
WEBHOOK_SECRET=change-me-shared-secret

# LLM providers. If both are unset the pipeline runs on a deterministic
# mock provider so you can develop/test the full flow with zero keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Public n8n webhook to trigger follow-up automations (optional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
