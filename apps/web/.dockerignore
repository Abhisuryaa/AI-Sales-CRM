.next/
out/
build/
*.tsbuildinfo
.turbo/
.eslintcache
.env
.env.*
!.env.example
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
Dockerfile
.dockerignore
